# LokLens News - environment variables (template; safe to commit, contains no secrets).
#
# Local dev: copy this file to apps/web/.env - Next.js and Payload read .env from the app folder.
#   cp .env.example apps/web/.env
# Never commit a real .env. Staging/production values live only on the server.

# --- Database -------------------------------------------------------------
# Matches the defaults in infra/docker-compose.dev.yml (user/password/db = loklens, port 5432).
DATABASE_URL=postgres://loklens:loklens@localhost:5432/loklens

# --- Payload --------------------------------------------------------------
# Long random string used to sign auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me-generate-with-the-command-above

# --- Site -----------------------------------------------------------------
# Public base URL, no trailing slash. Used for canonical URLs, sitemaps and previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for draft-preview links from the admin (generate like PAYLOAD_SECRET).
PREVIEW_SECRET=change-me-preview-secret

# Shared secret for on-demand revalidation requests (generate like PAYLOAD_SECRET).
REVALIDATE_SECRET=change-me-revalidate-secret

# --- Cloudflare (optional in dev; leave empty to skip CDN cache purges) ---
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# --- Server only (Hostinger VPS, infra/server) ------------------------------------------------------
# Not needed for local development. Read by infra/server/docker-compose.server.yml; the deploy stops if
# any of them is missing. On the server, DATABASE_URL above must use these same user/password/database
# (host 127.0.0.1, port 5432): the host runs the build and migrations against the database container.
# POSTGRES_USER=loklens
# POSTGRES_PASSWORD=generate-with-openssl-rand-hex-32
# POSTGRES_DB=loklens
# POSTGRES_PORT=5432
# Domain Caddy serves and gets the HTTPS certificate for.
# SITE_HOST=dev.loklens.com
# Basic auth in front of the whole development site (infra/server/Caddyfile). The hash is a bcrypt hash
# from `docker run --rm -it caddy:2-alpine caddy hash-password`. Keep the single quotes: the hash
# contains "$", which Docker Compose would otherwise try to expand.
# BASIC_AUTH_USER=loklens
# BASIC_AUTH_HASH='$2a$14$replace-with-the-output-of-caddy-hash-password'

# LokLens News - environment variables (template; safe to commit, contains no secrets).
#
# Local dev: copy this file to apps/web/.env - Next.js and Payload read .env from the app folder.
#   cp .env.example apps/web/.env
# Never commit a real .env. Staging/production values live only on the server.

# --- Database -------------------------------------------------------------
# Matches the defaults in infra/docker-compose.dev.yml (user/password/db = loklens, port 5432).
DATABASE_URL=postgres://loklens:loklens@localhost:5432/loklens
# Max database connections per Node process (default 5). Supabase's session pooler allows 15 in total.
# DB_POOL_MAX=5

# --- Payload --------------------------------------------------------------
# Long random string used to sign auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me-generate-with-the-command-above

# --- Site -----------------------------------------------------------------
# Public base URL, no trailing slash. Used for canonical URLs, sitemaps and previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for draft-preview links from the admin (generate like PAYLOAD_SECRET).
PREVIEW_SECRET=change-me-preview-secret

# Shared secret for on-demand revalidation requests (generate like PAYLOAD_SECRET).
REVALIDATE_SECRET=change-me-revalidate-secret

# --- Cloudflare (optional in dev; leave empty to skip CDN cache purges) ---
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# --- Supabase Storage (S3-compatible media storage) -----------------------
S3_BUCKET=loklens-media
S3_REGION=ap-northeast-2
S3_ENDPOINT=https://sfsfwcyrnddxjlrvuakf.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key

# --- Mobile app accounts and push notifications (docs/push-notifications.md) ---------------------------
# Google sign-in: the WEB OAuth client ID from Google Cloud (the one in apps/mobile/app.json
# "googleWebClientId"), NOT the Android client ID. Comma-separate several if needed.
GOOGLE_CLIENT_IDS=
# Secret for POST /api/cron (header x-cron-secret), called every minute by a Hostinger cron job so queued
# pushes, scheduled notifications and receipts run even after the idle app was stopped. openssl rand -hex 32
CRON_SECRET=
# Optional: Expo access token, required only after turning on "Enhanced push security" in the Expo project.
# Server-only; never put it in the mobile app.
EXPO_ACCESS_TOKEN=

# --- YouTube Studio (docs/youtube-studio-plan.md, api-contract.md §9; not built yet) ---------------
# Kill switch: leave empty/false until Release 1 is deployed and approved. When off, no YouTube job runs.
YOUTUBE_STUDIO_ENABLED=
# OAuth client "LokLens YouTube Studio" (Google Cloud project loklensnews, type Web application).
# The refresh token comes from the one-time consent by the @loklensnews channel owner (scope youtube.force-ssl).
# All three are server-only secrets.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
# PRIVATE Supabase bucket for raw footage (stored as <=45 MB segments; uses the S3_* credentials above).
FOOTAGE_S3_BUCKET=loklens-footage
# AI metadata suggestions: off in Release 1. Leave empty.
YOUTUBE_AI_ENABLED=
# Optional: upload chunk size in MB for each publisher step (default 8; rounded to 256 KB; max 64).
# YOUTUBE_CHUNK_MB=8

# --- Server only (Hostinger VPS, infra/server) ------------------------------------------------------
# Not needed for local development. Read by infra/server/docker-compose.server.yml; the deploy stops if
# any of them is missing. On the server, DATABASE_URL above must use these same user/password/database
# (host 127.0.0.1, port 5432): the host runs the build and migrations against the database container.
# POSTGRES_USER=loklens
# POSTGRES_PASSWORD=generate-with-openssl-rand-hex-32
# POSTGRES_DB=loklens
# POSTGRES_PORT=5432
# Domain Caddy serves and gets the HTTPS certificate for.
# SITE_HOST=dev.loklensnews.com
# Basic auth in front of the whole development site (infra/server/Caddyfile). The hash is a bcrypt hash
# from `docker run --rm -it caddy:2-alpine caddy hash-password`. Keep the single quotes: the hash
# contains "$", which Docker Compose would otherwise try to expand.
# BASIC_AUTH_USER=loklens
# BASIC_AUTH_HASH='$2a$14$replace-with-the-output-of-caddy-hash-password'

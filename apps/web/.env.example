# LokLens News - environment variables (template; safe to commit, contains no secrets).
#
# Copy this file to apps/web/.env for local development.
# In Hostinger Business Web Hosting, configure these variables in the Node.js Environment Variables panel.

# --- Database (Required in production; must point to external PostgreSQL / Supabase) ---
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# --- Payload CMS (Required) ---
PAYLOAD_SECRET=change-me-generate-32-byte-hex-secret

# --- Site URLs & Secrets ---
NEXT_PUBLIC_SITE_URL=https://dev.loklensnews.com
PREVIEW_SECRET=change-me-preview-secret
REVALIDATE_SECRET=change-me-revalidate-secret

# --- Supabase Storage (S3-compatible media storage) ---
S3_BUCKET=loklens-media
S3_REGION=ap-northeast-2
S3_ENDPOINT=https://sfsfwcyrnddxjlrvuakf.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key

# --- Cloudflare CDN (Optional) ---
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=


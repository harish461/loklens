{
  "name": "@loklens/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "db:seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts",
    "db:verify": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/verify-data.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@indic-transliteration/sanscript": "1.3.3",
    "@lexical/headless": "0.50.0",
    "@lexical/history": "0.50.0",
    "@lexical/link": "0.50.0",
    "@lexical/list": "0.50.0",
    "@lexical/react": "0.50.0",
    "@lexical/rich-text": "0.50.0",
    "@lexical/selection": "0.50.0",
    "@lexical/utils": "0.50.0",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-s3": "^3.93.0",
    "@payloadcms/translations": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "cross-env": "7.0.3",
    "graphql": "16.15.0",
    "lexical": "0.50.0",
    "lucide-react": "1.72.0",
    "next": "16.4.5",
    "payload": "3.93.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "3.10.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22"
  }
}
{
  "expo": {
    "name": "LokLens News",
    "slug": "loklens-news",
    "version": "0.2.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loklensnews.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.loklensnews.app",
      "googleServicesFile": "./google-services.json",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "versionCode": 5
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F5F9",
          "image": "./assets/brand/logo-square-1024.jpg",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C41D17",
          "defaultChannel": "news"
        }
      ]
    ],
    "scheme": "loklens",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://loklensnews.com/api/v1",
      "siteUrl": "https://loklensnews.com",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4c3042f7-108e-4441-a6cc-f28eecd7cac8"
      },
      "googleAndroidClientId": "484114320365-k5tt09am9so8mldercr650upth27656p.apps.googleusercontent.com",
      "googleWebClientId": "484114320365-2f3aqeqa2shf5c36jnk6cvltv2ev5vh3.apps.googleusercontent.com"
    },
    "owner": "loklensnews",
    "updates": {
      "url": "https://u.expo.dev/4c3042f7-108e-4441-a6cc-f28eecd7cac8"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}

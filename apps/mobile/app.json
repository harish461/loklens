{
  "expo": {
    "name": "LokLens News",
    "slug": "loklens-news",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loklensnews.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.loklensnews.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/logo-square-1024.jpg",
          "imageWidth": 160
        }
      ]
    ],
    "scheme": "loklens",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://loklensnews.com/api/v1",
      "siteUrl": "https://loklensnews.com"
    }
  }
}
